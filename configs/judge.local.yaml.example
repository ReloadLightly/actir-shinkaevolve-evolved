# Local Stage B authorization — copy to configs/judge.local.yaml to use.
#
#     cp configs/judge.local.yaml.example configs/judge.local.yaml
#     export JAPAN_FP_JUDGE_CONFIG=configs/judge.local.yaml
#     export OPENAI_API_KEY=sk-...
#
# The copy is gitignored. This template is not loaded by anything: it ends in
# .example precisely so no glob, test or script can pick it up by accident.
#
# WHY THIS EXISTS. configs/judge.yaml ships locked (mode: mock,
# stage_b_authorized: false) and a test keeps it that way forever. Rather than
# edit the shipped file — which would risk committing an armed config, and
# would make "is the repo safe" depend on remembering to revert — authorization
# lives in a separate local file you create deliberately and that git cannot
# see. The shipped guarantee stays true no matter what you run locally.
#
# THIS FILE ARMS THE JUDGE. Copying it means real API calls will be made and
# real money will be spent. M1 is about $0.04; check with --estimate first.

mode: real                              # ARMED
stage_b_authorized: true                # ARMED

provider: openai
model: gpt-4.1-mini-2025-04-14          # dated snapshot = genuinely pinned
temperature: 0.0
max_tokens: 2000

prompt_version: draft-0

# Same cache and ledger as the shipped config, so a local run still writes the
# audit trail (KICKOFF hard rule 5) and you can commit it afterwards.
cache_dir: tasks/japan_fp/judge/cache
ledger_path: runs/ledger/judge_calls.jsonl
